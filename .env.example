# Sao chep file nay thanh ".env" roi dien khoa that.
# Nhieu khoa Gemini (lay tai https://aistudio.google.com/apikey), ngan cach bang dau phay.
# Khi mot khoa het quota / loi, server tu dong chuyen sang khoa ke tiep.
GEMINI_API_KEYS=key_mot,key_hai,key_ba

# Model Gemini dung cho chat (tuy chon). Mac dinh: gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite

# Muc suy nghi cua model (tuy chon): minimal | low | medium | high | none. Mac dinh: minimal (chu dau ra nhanh nhat).
# GEMINI_THINKING_LEVEL=minimal

# Do ngau nhien khi nhan vat tra loi (tuy chon, 0-2). Mac dinh: 0.5
# GEMINI_TEMPERATURE=0.5

# AI Dao dien (Phase 3, tuy chon). Model rieng de han muc (tinh theo project + model) khong an vao han muc cua chat.
# DIRECTOR_MODEL=gemini-3.1-flash-lite
# Model du phong cho lan goi thu 2 tro di (khi model chinh loi hoac qua 1,5 giay). Tat du phong: none
# DIRECTOR_FALLBACK_MODEL=gemini-3.5-flash-lite
# Tat han dao dien (khong goi AI, khong co anh): DIRECTOR_ENABLED=false
# DIRECTOR_ENABLED=true
# Muc suy nghi cua model dao dien: minimal | low | medium | high | none. Mac dinh: minimal
# DIRECTOR_THINKING_LEVEL=minimal
