# Sao chep file nay thanh ".env" roi dien khoa that.
# Nhieu khoa Gemini (lay tai https://aistudio.google.com/apikey), ngan cach bang dau phay.
# Khi mot khoa het quota / loi, server tu dong chuyen sang khoa ke tiep.
GEMINI_API_KEYS=key_mot,key_hai,key_ba

# Model Gemini dung cho chat (tuy chon). Mac dinh: gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite
